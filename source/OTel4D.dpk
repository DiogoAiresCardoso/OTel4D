package OTel4D;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$IMPLICITBUILD ON}

{$RUNONLY}

requires
  rtl;

contains
  OTel.Domain.TraceHeaders in 'domain\OTel.Domain.TraceHeaders.pas',
  OTel.Application.Configuration in 'application\OTel.Application.Configuration.pas',
  OTel.Otlp.Exporter in 'adapters\otlp\OTel.Otlp.Exporter.pas',
  OTel.Transport.Contracts in 'adapters\otlp\OTel.Transport.Contracts.pas',
  OTel.Runtime.BackgroundWorker in 'adapters\runtime\OTel.Runtime.BackgroundWorker.pas',
  OTel.Runtime.Contracts in 'adapters\runtime\OTel.Runtime.Contracts.pas',
  OTel.Windows.Clock in 'adapters\windows\OTel.Windows.Clock.pas',
  OTel.Application.Ports in 'application\OTel.Application.Ports.pas',
  OTel.Application.Session in 'application\OTel.Application.Session.pas',
  OTel.Bootstrap in 'bootstrap\OTel.Bootstrap.pas',
  OTel.Bootstrap.Signals in 'bootstrap\OTel.Bootstrap.Signals.pas',
  OTel.Instrumentation.Database.Contracts in 'adapters\database\OTel.Instrumentation.Database.Contracts.pas',
  OTel.Instrumentation.Database.Recorder in 'adapters\database\OTel.Instrumentation.Database.Recorder.pas',
  OTel.Instrumentation.Database.Operation in 'adapters\database\OTel.Instrumentation.Database.Operation.pas',
  OTel.View.ProtobufResponse in 'adapters\otlp\OTel.View.ProtobufResponse.pas',
  OTel.Controller.MetricWorker in 'adapters\runtime\OTel.Controller.MetricWorker.pas',
  OTel.Controller.DeliveryWorker in 'adapters\runtime\OTel.Controller.DeliveryWorker.pas',
  OTel.Transport.ResponseLimit in 'adapters\otlp\OTel.Transport.ResponseLimit.pas',
  OTel.Transport.ResponseStream in 'adapters\otlp\OTel.Transport.ResponseStream.pas',
  OTel.Model.Dto.SignalSettings in 'domain\OTel.Model.Dto.SignalSettings.pas',
  OTel.Model.Dto.Options in 'domain\OTel.Model.Dto.Options.pas',
  OTel.Model.Dto.ConfigurationError in 'domain\OTel.Model.Dto.ConfigurationError.pas',
  OTel.Model.Dto.SpanEvent in 'domain\OTel.Model.Dto.SpanEvent.pas',
  OTel.Model.Dto.MetricDefinition in 'domain\OTel.Model.Dto.MetricDefinition.pas',
  OTel.Model.Service.MetricSeries in 'domain\OTel.Model.Service.MetricSeries.pas',
  OTel.Controller.Span in 'adapters\api\OTel.Controller.Span.pas',
  OTel.Controller.MetricInstrument in 'adapters\api\OTel.Controller.MetricInstrument.pas',
  OTel.Controller.Counter in 'adapters\api\OTel.Controller.Counter.pas',
  OTel.Controller.Histogram in 'adapters\api\OTel.Controller.Histogram.pas',
  OTel.Controller.Configuration in 'adapters\api\OTel.Controller.Configuration.pas',
  OTel.Model.Dto.Metric in 'domain\OTel.Model.Dto.Metric.pas',
  OTel.Model.Service.MetricStore in 'application\OTel.Model.Service.MetricStore.pas',
  OTel.Controller.Meter in 'adapters\api\OTel.Controller.Meter.pas',
  OTel.Controller.MetricReader in 'adapters\runtime\OTel.Controller.MetricReader.pas',
  OTel.View.MetricProtobuf in 'adapters\otlp\OTel.View.MetricProtobuf.pas',
  OTel.Model.Dto.Telemetry in 'domain\OTel.Model.Dto.Telemetry.pas',
  OTel.Model.Dto.Log in 'domain\OTel.Model.Dto.Log.pas',
  OTel.Controller.Logger in 'adapters\api\OTel.Controller.Logger.pas',
  OTel.Controller.BatchedSignal in 'adapters\runtime\OTel.Controller.BatchedSignal.pas',
  OTel.View.LogProtobuf in 'adapters\otlp\OTel.View.LogProtobuf.pas',
  OTel.View.Protobuf in 'adapters\otlp\OTel.View.Protobuf.pas',
  OTel.Api in 'adapters\api\OTel.Api.pas',
  OTel.Model.Dto.Configuration in 'domain\OTel.Model.Dto.Configuration.pas',
  OTel.Model.Dao.Environment in 'adapters\configuration\OTel.Model.Dao.Environment.pas',
  OTel.Model.Service.Configuration in 'application\OTel.Model.Service.Configuration.pas',
  OTel.View.TraceEndpoint in 'adapters\configuration\OTel.View.TraceEndpoint.pas',
  OTel.Controller.SpanQueue in 'adapters\runtime\OTel.Controller.SpanQueue.pas',
  OTel.Controller.Trace in 'adapters\api\OTel.Controller.Trace.pas',
  OTel.Controller.TraceClient in 'adapters\api\OTel.Controller.TraceClient.pas',
  OTel.Transport.Http in 'adapters\otlp\OTel.Transport.Http.pas',
  OTel.Model.Dto.Span in 'domain\OTel.Model.Dto.Span.pas',
  OTel.Model.Service.TraceContext in 'adapters\windows\OTel.Model.Service.TraceContext.pas',
  OTel.View.TraceProtobuf in 'adapters\otlp\OTel.View.TraceProtobuf.pas';

end.
